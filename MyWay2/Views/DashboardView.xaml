<UserControl x:Class="MyWay.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="24,20,24,24">

            <TextBlock Style="{StaticResource SectionHeader}" FontSize="22">
                <Run Text="🌅  Dzień dobry!  "/>
                <Run Text="{Binding TodayRecord.Date, StringFormat={}{0:dddd, dd MMMM yyyy}, Mode=OneWay}"
                     Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" FontWeight="Normal"/>
            </TextBlock>

            <Border Style="{StaticResource QuoteCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="💬 Cytat dnia" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding QuoteText}" FontSize="14" FontStyle="Italic"
                               Foreground="{StaticResource BgDarkBrush}"
                               TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">


                    <Border Style="{StaticResource FilterPanelCard}" Margin="0,0,0,16" Padding="12">
                        <StackPanel>

                            <!-- Naglowek -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                    Style="{StaticResource FilterTile}"
                    Padding="7,4"
                    Margin="0,0,8,0">
                                    <TextBlock Text="🔥"
                           FontSize="14"
                           VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nawyki"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <TextBlock Text="Twoje codzienne cele i streaki"
                           FontSize="10"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Opacity="0.85"/>
                                </StackPanel>
                            </Grid>

                            <!-- Statystyki + dodawanie -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                    Style="{StaticResource FilterTile}"
                    Padding="12,6"
                    Margin="0,0,10,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CompletedToday}"
                               FontSize="20"
                               FontWeight="Black"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>

                                        <TextBlock Text="ukonczone dzis"
                               FontSize="9"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                    Style="{StaticResource FilterTile}"
                    Padding="12,6"
                    Margin="0,0,10,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalStreakDays}"
                               FontSize="20"
                               FontWeight="Black"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>

                                        <TextBlock Text="aktualny streak"
                               FontSize="9"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                    Style="{StaticResource FilterTile}"
                    Padding="12,6"
                    Margin="0,0,12,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding BestStreak}"
                               FontSize="20"
                               FontWeight="Black"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>

                                        <TextBlock Text="najlepszy streak"
                               FontSize="9"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                                    <TextBox Style="{StaticResource FilterTextBox}"
                         Text="{Binding NewHabitTitle, UpdateSourceTrigger=PropertyChanged}"
                         Width="170"
                         Height="30"
                         FontSize="11"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return"
                                    Command="{Binding AddHabitCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <Button Content="➕ Dodaj"
                        Style="{StaticResource GreenButton}"
                        Command="{Binding AddHabitCommand}"
                        Padding="12,6"
                        Height="30"
                        FontSize="11"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <ItemsControl ItemsSource="{Binding Habits}" Padding="12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource TaskItemCard}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompletedToday}" Value="True">
                                                        <Setter Property="Background" Value="#2F6F73"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentGreenShadowBrush}"/>
                                                        <Setter Property="Opacity" Value="0.85"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding IsCompletedToday}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource AccentPurpleBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleShadowBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                  Style="{StaticResource PrettyCheckBox}"
                                  IsChecked="{Binding IsCompletedToday, Mode=OneWay}"
                                  Command="{Binding DataContext.ToggleHabitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}"
                                  Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TaskTitleText}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompletedToday}" Value="True">
                                                                    <Setter Property="Foreground" Value="#CFEFED"/>
                                                                    <Setter Property="Opacity" Value="0.85"/>
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding IsCompletedToday}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <StackPanel Orientation="Horizontal"
                                        Margin="0,3,0,0">

                                                    <TextBlock Text="{Binding StreakLabel}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                                    <TextBlock FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="12,0,0,0">
                                    <Run Text="Rekord: "/>
                                    <Run Text="{Binding BestStreak, Mode=OneWay}"/>
                                    <Run Text=" dni"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">

                                                <Button Content="🗑"
                                    Style="{StaticResource DangerButton}"
                                    Padding="7,4"
                                    FontSize="12"
                                    MinWidth="30"
                                    Command="{Binding DataContext.DeleteHabitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="😊 Twój nastrój dziś" Style="{StaticResource SectionHeader}" FontSize="14"/>
                        <TextBlock Text="{Binding TodayRecord.MoodLabel}" FontSize="28"
                                   HorizontalAlignment="Center" Margin="0,8"/>

                        <Slider Minimum="0" Maximum="5" TickFrequency="1"
                                IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                Value="{Binding TodayRecord.MoodScore}"
                                Style="{StaticResource MoodSlider}"
                                Margin="0,4,0,12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="😞" FontSize="12" Margin="0,0,8,0" Opacity="0.5"/>
                            <TextBlock Text="1                2                3                4                5" FontSize="10"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="😄" FontSize="12" Margin="8,0,0,0" Opacity="0.5"/>
                        </StackPanel>

                        <Button Content="Zapisz nastrój" Style="{StaticResource GreenButton}"
                                Command="{Binding SaveMoodCommand}"
                                Margin="0,16,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>