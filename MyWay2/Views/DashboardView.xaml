<UserControl x:Class="MyWay.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="24,20,24,24">

            <TextBlock Style="{StaticResource SectionHeader}" FontSize="22">
                <Run Text="🌅  Dzień dobry!  "/>
                <Run Text="{Binding TodayRecord.Date, StringFormat={}{0:dddd, dd MMMM yyyy}, Mode=OneWay}"
                     Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" FontWeight="Normal"/>
            </TextBlock>

            <!-- GŁÓWNY PANEL ZAKŁADKI (Zielony Cytat) -->
            <Border Style="{StaticResource QuoteCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="💬 Cytat dnia" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding QuoteText}" FontSize="14" FontStyle="Italic"
                               Foreground="{StaticResource BgDarkBrush}"
                               TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- ========================================== -->
                <!-- LEWA KOLUMNA: NAWYKI                       -->
                <!-- ========================================== -->
                <StackPanel Grid.Column="0">

                    <!-- Główny kontener na wszystko (Fioletowy) -->
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>

                            <!-- NAGŁÓWEK W PANELU -->
                            <Grid Margin="2,0,2,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{StaticResource AccentGreenBrush}"
                                        BorderBrush="{StaticResource AccentGreenShadowBrush}"
                                        BorderThickness="0,0,0,2"
                                        CornerRadius="8"
                                        Padding="6,3"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="🔥"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Nawyki"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Buduj dobre przyzwyczajenia"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ZIELONY MINI-PANEL (Statystyki i dodawanie) -->
                            <Border Background="{StaticResource AccentGreenBrush}" 
                                    BorderBrush="{StaticResource AccentGreenShadowBrush}" 
                                    BorderThickness="0,0,0,3" 
                                    CornerRadius="10" Padding="12,10" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Statystyki w oddzielnych ramkach (styl z TasksView) -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                                        <Border BorderBrush="{StaticResource AccentGreenShadowBrush}" BorderThickness="1" CornerRadius="8" Padding="12,4" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding CompletedToday}" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="dziś" FontSize="8" Foreground="White" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="{StaticResource AccentGreenShadowBrush}" BorderThickness="1" CornerRadius="8" Padding="12,4" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TotalStreakDays}" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="streak" FontSize="8" Foreground="White" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="{StaticResource AccentGreenShadowBrush}" BorderThickness="1" CornerRadius="8" Padding="12,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding BestStreak}" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="rekord" FontSize="8" Foreground="White" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>

                                    <!-- Pole dodawania -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBox Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding NewHabitTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="150" Margin="0,0,8,0" VerticalContentAlignment="Center" Height="30" FontSize="11" Padding="8,2"/>
                                        <!-- Przycisk jest fioletowy (BaseButton), żeby był widoczny na zielonym tle mini-panelu -->
                                        <Button Content="➕ Dodaj" Style="{StaticResource BaseButton}" FontSize="11"
                                                Command="{Binding AddHabitCommand}" Padding="10,0" Height="30"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Lista Nawyków w głównym fioletowym panelu -->
                            <ItemsControl ItemsSource="{Binding Habits}" Padding="0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                BorderThickness="0,0,0,3" 
                                                CornerRadius="8" Padding="12,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource CardShadowBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompletedToday}" Value="True">
                                                            <Setter Property="Background" Value="#2F6F73"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenShadowBrush}"/>
                                                            <Setter Property="Opacity" Value="0.85"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                                        Background="{Binding IsCompletedToday, Converter={StaticResource CompletedTodayToColor}}"
                                                        BorderBrush="{Binding CurrentStreak, Converter={StaticResource StreakToColor}}"
                                                        BorderThickness="2" Margin="0,0,12,0" Cursor="Hand" VerticalAlignment="Center">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.ToggleHabitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="White">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value=""/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompletedToday}" Value="True">
                                                                        <Setter Property="Text" Value="✓"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                               TextDecorations="{Binding IsCompletedToday, Converter={StaticResource CompletedToStrike}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompletedToday}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource BgDarkBrush}"/>
                                                                        <Setter Property="Opacity" Value="0.8"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding StreakLabel}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{Binding CurrentStreak, Converter={StaticResource StreakToColor}}"/>
                                                        <TextBlock FontSize="11" Margin="8,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompletedToday}" Value="True">
                                                                            <Setter Property="Foreground" Value="#B8E5DF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="Rekord: "/>
                                                            <Run Text="{Binding BestStreak, Mode=OneWay}"/>
                                                            <Run Text=" dni"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Button Grid.Column="2" Content="🗑" Style="{StaticResource DangerButton}"
                                                        Padding="8,4" FontSize="12" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.DeleteHabitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========================================== -->
                <!-- PRAWA KOLUMNA: NASTRÓJ                     -->
                <!-- ========================================== -->
                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource Card}" VerticalAlignment="Top" Padding="16">
                        <StackPanel>

                            <!-- NAGŁÓWEK W PANELU -->
                            <Grid Margin="2,0,2,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{StaticResource AccentGreenBrush}"
                                        BorderBrush="{StaticResource AccentGreenShadowBrush}"
                                        BorderThickness="0,0,0,2"
                                        CornerRadius="8"
                                        Padding="6,3"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="😊"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Twój nastrój dziś"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Jak się dzisiaj czujesz?"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ZIELONY MINI-PANEL (Odczyt Nastroju) -->
                            <Border Background="{StaticResource AccentGreenBrush}" 
                                    BorderBrush="{StaticResource AccentGreenShadowBrush}" 
                                    BorderThickness="0,0,0,3" 
                                    CornerRadius="10" Padding="16,20" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding TodayRecord.MoodLabel}" FontSize="28" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                                    <Slider Minimum="1" Maximum="5" TickFrequency="1"
                                            IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                            Value="{Binding TodayRecord.MoodScore}"
                                            Style="{StaticResource MoodSlider}" Foreground="White"
                                            Margin="0,4,0,12"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="😞" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource BgDarkBrush}"/>
                                        <TextBlock Text="1                2                3                4                5" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource BgDarkBrush}"/>
                                        <TextBlock Text="😄" FontSize="12" Margin="8,0,0,0" Foreground="{StaticResource BgDarkBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button Content="Zapisz nastrój" Style="{StaticResource GreenButton}"
                                    Command="{Binding SaveMoodCommand}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>