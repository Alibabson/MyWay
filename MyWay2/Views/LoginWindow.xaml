<Window x:Class="MyWay.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyWay – Logowanie"
        Height="460" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        WindowStyle="SingleBorderWindow">

    <Border Background="{StaticResource BgDarkBrush}" Padding="0">
        <Grid>
            <StackPanel VerticalAlignment="Center" Margin="40,0">

                <!-- Logo / tytuł -->
                <TextBlock Text="MyWay"
                           FontSize="40" FontWeight="Black"
                           Foreground="{StaticResource AccentPurpleBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Twoja produktywność"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,36"/>

                <!-- Email -->
                <TextBlock Text="Adres e-mail"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="TxtEmail"
                         Style="{StaticResource ModernTextBox}"
                         FontSize="14"
                         Margin="0,0,0,16"
                         KeyDown="Input_KeyDown"/>

                <!-- Hasło -->
                <TextBlock Text="Hasło"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtPassword"
                             Style="{StaticResource ModernPasswordBox}"
                             FontSize="14"
                             Margin="0,0,0,8"
                             KeyDown="Input_KeyDown"/>

                <!-- Komunikat błędu -->
                <TextBlock x:Name="TxtError"
                           FontSize="12"
                           Foreground="{StaticResource DangerRedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           Visibility="Collapsed"/>

                <!-- Przycisk logowania -->
                <Button x:Name="BtnLogin"
                        Content="Zaloguj się"
                        Style="{StaticResource AccentButton}"
                        FontSize="15"
                        Height="44"
                        Click="Login_Click"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>
