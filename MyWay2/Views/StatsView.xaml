<UserControl x:Class="MyWay.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="24,20,24,24">

            <!-- Section Header -->
            <TextBlock Style="{StaticResource SectionHeader}" FontSize="18" Margin="0,0,0,12">
                <Run Text="📊  Statystyki"/>
            </TextBlock>

            <!-- Header panel -->
            <Border Style="{StaticResource FilterPanelCard}"
                    Margin="0,0,0,16"
                    Padding="12,8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lewa część: przyciski wyboru okresu -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <TextBlock Text="Okres:"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <!-- Tydzień -->
                        <Button Content="Tydzień"
                                Command="{Binding ChangePeriodCommand}"
                                CommandParameter="Tydzień"
                                Height="30"
                                Padding="14,6"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueShadowBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatsPeriod}" Value="Tydzień">
                                            <Setter Property="Background" Value="{StaticResource AccentPurpleBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleShadowBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,3"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Miesiąc -->
                        <Button Content="Miesiąc"
                                Command="{Binding ChangePeriodCommand}"
                                CommandParameter="Miesiąc"
                                Height="30"
                                Padding="14,6"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueShadowBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatsPeriod}" Value="Miesiąc">
                                            <Setter Property="Background" Value="{StaticResource AccentPurpleBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleShadowBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,3"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Rok -->
                        <Button Content="Rok"
                                Command="{Binding ChangePeriodCommand}"
                                CommandParameter="Rok"
                                Height="30"
                                Padding="14,6"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueShadowBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatsPeriod}" Value="Rok">
                                            <Setter Property="Background" Value="{StaticResource AccentPurpleBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleShadowBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,3"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Wszystkie -->
                        <Button Content="Wszystkie"
                                Command="{Binding ChangePeriodCommand}"
                                CommandParameter="Wszystkie"
                                Height="30"
                                Padding="14,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueShadowBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatsPeriod}" Value="Wszystkie">
                                            <Setter Property="Background" Value="{StaticResource AccentPurpleBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleShadowBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,3"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Prawa część: Eksport PDF -->
                    <Button Grid.Column="1"
                            Style="{StaticResource GreenButton}"
                            Command="{Binding ExportPdfCommand}"
                            IsEnabled="{Binding IsExporting, Converter={StaticResource BoolToInvVis}}"
                            Height="30"
                            Padding="12,6"
                            FontSize="11"
                            VerticalAlignment="Center">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="📄 Eksportuj PDF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                            <Setter Property="Text" Value="⏳ Eksportuję..."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>
            </Border>

            <!-- Summary cards -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource TaskItemCard}"
                        Background="{StaticResource AccentPurpleBrush}"
                        BorderBrush="{StaticResource AccentPurpleShadowBrush}"
                        Padding="16,12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🏆 Łączne punkty"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding PeriodTotalPoints}"
                                   FontSize="36"
                                   FontWeight="Black"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="pkt"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Opacity="0.85"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource TaskItemCard}"
                        Background="#2F6F73"
                        BorderBrush="{StaticResource AccentGreenShadowBrush}"
                        Padding="16,12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="😊 Śr. nastrój"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding PeriodAvgMoodLabel}"
                                   FontSize="36"
                                   FontWeight="Black"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="/ 5"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Opacity="0.85"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource TaskItemCard}"
                        Background="{StaticResource AccentBlueBrush}"
                        BorderBrush="{StaticResource AccentBlueShadowBrush}"
                        Padding="16,12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📅 Dni z danymi"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding PeriodRecords.Count}"
                                   FontSize="36"
                                   FontWeight="Black"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="dni"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Opacity="0.85"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Daily records table -->
            <Border Style="{StaticResource Card}"
                    Padding="12">
                <StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource FilterTile}"
                                Padding="7,4"
                                Margin="0,0,8,0">
                            <TextBlock Text="📋"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Dzienne podsumowanie"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock Text="Lista wyników z wybranego okresu"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Border Visibility="{Binding PeriodRecords.Count, Converter={StaticResource NullToVis}}"
                            Background="{StaticResource BgDarkBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="6">

                        <DataGrid ItemsSource="{Binding PeriodRecords}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  RowBackground="{StaticResource BgCardBrush}"
                                  AlternatingRowBackground="#343179"
                                  HeadersVisibility="Column"
                                  CanUserResizeRows="False"
                                  SelectionMode="Single"
                                  RowHeight="34">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource AccentPurpleBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,7"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleShadowBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data"
                                                    Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Nastrój"
                                                    Binding="{Binding MoodEmoji}"
                                                    Width="90"/>

                                <DataGridTextColumn Header="Pkt. zadań"
                                                    Binding="{Binding TaskPoints}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Pkt. ekstra"
                                                    Binding="{Binding ExtraPoints}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Łącznie"
                                                    Binding="{Binding TotalPoints}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Text="Brak danych dla wybranego okresu."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPeriodRecords}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>