<UserControl x:Class="MyWay.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyWay.Converters"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,28" MaxWidth="780">

            <!-- Nagłówek -->
            <TextBlock Text="👤  Profil" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>

            <!-- Karta profilu -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40"
                            Background="#2A2860" Margin="0,0,20,0">
                        <TextBlock Text="{Binding Profile.AvatarEmoji}"
                                   FontSize="36" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Dane -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Profile.DisplayName}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Profile.JoinedLabel}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="📅 " FontSize="12"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding Profile.DaysActive, Mode=OneWay}"/>
                                <Run Text=" dni z aplikacją"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Przycisk edycji -->
                    <Button Grid.Column="2" Content="✏️  Edytuj"
                            Style="{StaticResource BaseButton}"
                            Command="{Binding StartEditCommand}"
                            Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}"
                            Padding="12,8" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Panel edycji -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Edytuj profil" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <!-- Nazwa -->
                    <TextBlock Text="Twoje imię / pseudonim" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             MaxLength="40" Margin="0,0,0,16"/>

                    <!-- Cel dzienny -->
                    <TextBlock Text="Dzienny cel punktowy" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditGoal, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             MaxLength="4" Width="120" HorizontalAlignment="Left"
                             Margin="0,0,0,16"/>

                    <!-- Wybór awatara -->
                    <TextBlock Text="Wybierz awatar" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding AvailableAvatars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        FontSize="22"
                                        Width="44" Height="44"
                                        Margin="4"
                                        Style="{StaticResource BaseButton}"
                                        Command="{Binding DataContext.SelectAvatarCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Podgląd wybranego awatara -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,16">
                        <TextBlock Text="Wybrany awatar: " Style="{StaticResource Label}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EditAvatar}" FontSize="28"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Przyciski -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="💾  Zapisz" Style="{StaticResource AccentButton}"
                                Command="{Binding SaveProfileCommand}"
                                Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Anuluj" Style="{StaticResource BaseButton}"
                                Command="{Binding CancelEditCommand}"
                                Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Statystyki całościowe -->
            <TextBlock Text="Twoje statystyki" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,12"/>

            <!-- Wiersz górny: 2 karty -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Łączne punkty -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalPoints}" FontSize="36" FontWeight="Black"
                                       Foreground="{StaticResource AccentPurpleBrush}"/>
                            <TextBlock Text="Łączne punkty" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22"
                                Background="#2A2360" VerticalAlignment="Center">
                            <TextBlock Text="PKT" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource AccentPurpleBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Ukończone zadania -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalTasksDone}" FontSize="36" FontWeight="Black"
                                       Foreground="{StaticResource AccentGreenBrush}"/>
                            <TextBlock Text="Zadań ukończonych" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22"
                                Background="#1A3830" VerticalAlignment="Center">
                            <TextBlock Text="ZAD" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource AccentGreenBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Wiersz dolny: 2 karty -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Średni nastrój -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AvgMoodLabel}" FontSize="36" FontWeight="Black"
                                       Foreground="{StaticResource AccentTealBrush}"/>
                            <TextBlock Text="Śr. nastrój (skala 1–5)" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22"
                                Background="#0A2E2C" VerticalAlignment="Center">
                            <TextBlock Text="1-5" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource AccentTealBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Aktywne dni -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveDays}" FontSize="36" FontWeight="Black"
                                       Foreground="#FF9800"/>
                            <TextBlock Text="Aktywnych dni" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22"
                                Background="#2E1E00" VerticalAlignment="Center">
                            <TextBlock Text="DNI" FontSize="10" FontWeight="Bold"
                                       Foreground="#FF9800"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Pasek dziennego celu -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="🎯  Dzienny cel punktowy"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding DailyProgressLabel}"
                                   FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    <Border Height="12" CornerRadius="6" Background="#2A2860">
                        <Border HorizontalAlignment="Left" CornerRadius="6"
                                Background="{StaticResource AccentPurpleBrush}">
                            <Border.Width>
                                <MultiBinding>
                                    <MultiBinding.Converter>
                                        <local:ProgressWidthConverter />
                                    </MultiBinding.Converter>
                                    <Binding Path="DailyProgress"/>
                                    <Binding RelativeSource="{RelativeSource AncestorType=Border,
                                             AncestorLevel=1}" Path="ActualWidth"/>
                                </MultiBinding>
                            </Border.Width>
                            <Border.Height>12</Border.Height>
                        </Border>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
