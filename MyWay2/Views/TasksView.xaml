<UserControl x:Class="MyWay.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SegmentedListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#12121F"/> 
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource AccentPurpleBrush}"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,10,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="✅ Zadania" Style="{StaticResource SectionHeader}" FontSize="18" Margin="0"/>
        </StackPanel>

        <Border Grid.Row="1"
        Style="{StaticResource FilterPanelCard}"
        Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Lewa część: wyszukiwanie, status, sortowanie -->
                <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <!-- Szukaj -->
                    <Border Style="{StaticResource FilterTile}"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔎"
                               FontSize="12"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                            <TextBox Style="{StaticResource FilterTextBox}"
                             Width="120"
                             Height="30"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <!-- Status -->
                    <Border Style="{StaticResource FilterTile}"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Status:"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                            <ComboBox Style="{StaticResource FilterComboBox}"
                              Width="120"
                              Height="30"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding FilterStatus}"/>
                        </StackPanel>
                    </Border>

                    <!-- Sortuj -->
                    <Border Style="{StaticResource FilterTile}"
                    VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sortuj:"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                            <ComboBox Style="{StaticResource FilterComboBox}"
                              Width="120"
                              Height="30"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SortBy}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Prawa część: statystyki -->
                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="15,0,0,0">

                    <Border Style="{StaticResource FilterTile}"
                    Padding="10,4"
                    Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TodayCompleted}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                            <TextBlock Text="dziś"
                               FontSize="8"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FilterTile}"
                    Padding="10,4"
                    Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding OverdueCount}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                            <TextBlock Text="zaległe"
                               FontSize="8"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FilterTile}"
                    Padding="10,4">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalPoints}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                            <TextBlock Text="pkt"
                               FontSize="8"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <ListView ItemsSource="{Binding TasksView}" Background="Transparent" BorderThickness="0" Padding="5">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TaskItemCard}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="Background" Value="#2F6F73"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenShadowBrush}"/>
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsCompleted}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource AccentPurpleBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleShadowBrush}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerRedShadowBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                          Style="{StaticResource PrettyCheckBox}"
                          IsChecked="{Binding IsCompleted, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                          CommandParameter="{Binding}"
                          Margin="0,0,10,0"/>

                                    <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                                        <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                                            <TextBlock Text="{Binding Title}"
                                   TextDecorations="{Binding IsCompleted, Converter={StaticResource CompletedToStrike}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TaskTitleText}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BgDarkBrush}"/>
                                                                <Setter Property="Opacity" Value="0.8"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFB3A7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Border Style="{StaticResource TaskDifficultyBadge}"
                                Background="{Binding Difficulty, Converter={StaticResource DiffToColor}}">
                                                <TextBlock Text="{Binding DifficultyIcon}"
                                       FontSize="10"
                                       Foreground="White"
                                       FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                Margin="0,2,0,0">
                                            <TextBlock Text="{Binding DueDate, StringFormat={}{0:dd.MM.yyyy}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TaskDateText}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Foreground" Value="#B8E5DF"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF7043"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Margin="12,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TaskDateText}">
                                                        <Setter Property="Text" Value="{Binding TimeSpentLabel, StringFormat='⏱ {0}'}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TimeSpentSeconds}" Value="0">
                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Foreground" Value="#B8E5DF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF7043"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">

                                        <Button Content="🎯"
                            Style="{StaticResource BlueButton}"
                            Padding="7,4"
                            FontSize="12"
                            MinWidth="30"
                            Command="{Binding DataContext.StartFocusCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                            CommandParameter="{Binding}"/>

                                        <Button Content="✏️"
                            Style="{StaticResource GreenButton}"
                            Padding="7,4"
                            FontSize="12"
                            MinWidth="30"
                            Margin="5,0,0,0"
                            Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                            CommandParameter="{Binding}"/>

                                        <Button Content="🗑"
                            Style="{StaticResource DangerButton}"
                            Padding="7,4"
                            FontSize="12"
                            MinWidth="30"
                            Margin="5,0,0,0"
                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                            CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CalendarCard}">
                    <StackPanel>

                        <Grid Margin="2,0,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                    Background="{StaticResource AccentBlueBrush}"
                    BorderBrush="{StaticResource AccentBlueShadowBrush}"
                    BorderThickness="0,0,0,2"
                    CornerRadius="8"
                    Padding="6,3"
                    Margin="0,0,8,0">
                                <TextBlock Text="📅"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Wybierz dzień"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                <TextBlock Text="{Binding SelectedDate, StringFormat={}{0:dd MMMM yyyy}}"
                           FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource CalendarInnerPanel}">
                            <Border Background="{StaticResource AccentBlueLightBrush}"
                    BorderBrush="{StaticResource AccentBlueShadowBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="5">
                                <Viewbox MaxHeight="185">
                                    <Calendar SelectedDate="{Binding SelectedDate}"
                              Style="{StaticResource PrettyCalendar}"/>
                                </Viewbox>
                            </Border>
                        </Border>

                    </StackPanel>
                </Border>
                <Border Style="{StaticResource NewTaskCard}" Padding="10">
                    <StackPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                    Style="{StaticResource NewTaskHeaderIcon}"
                    Padding="5,2"
                    Margin="0,0,6,0">
                                <TextBlock Text="➕"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nowe zadanie"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                <TextBlock Text="Dodaj do wybranego dnia"
                           FontSize="9"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Nazwa zadania"
                   Style="{StaticResource NewTaskLabel}"
                   Margin="0,0,0,2"/>

                        <TextBox Style="{StaticResource DarkTextBox}"
                 Height="30"
                 FontSize="11"
                 Padding="8,2"
                 Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,6"/>

                        <TextBlock Text="Trudnosc"
                   Style="{StaticResource NewTaskLabel}"
                   Margin="0,0,0,2"/>

                        <ListBox Style="{StaticResource SegmentedListBox}"
                 ItemContainerStyle="{StaticResource SegmentedListBoxItem}"
                 SelectedValue="{Binding NewDifficulty}"
                 SelectedValuePath="Tag"
                 Margin="0,0,0,6">

                            <ListBoxItem Content="⭐ Latwe" Tag="1" IsSelected="True"/>
                            <ListBoxItem Content="⭐⭐ Srednie" Tag="2"/>
                            <ListBoxItem Content="⭐⭐⭐ Trudne" Tag="3"/>
                        </ListBox>

                        <TextBlock Text="Termin"
                   Style="{StaticResource NewTaskLabel}"
                   Margin="0,0,0,2"/>

                        <Border Style="{StaticResource NewTaskDateBox}"
                Padding="6,3"
                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                           Text="📅"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>

                                <TextBlock Grid.Column="1"
                           Text="{Binding NewDueDate, StringFormat={}{0:dd MMMM yyyy}}"
                           FontSize="10"
                           Foreground="White"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                    Content="➕ Dodaj"
                    Style="{StaticResource BaseButton}"
                    Command="{Binding AddTaskCommand}"
                    Height="28"
                    FontSize="10"
                    Padding="8,4"/>

                            <Button Grid.Column="2"
                    Content="✅ Zrobione"
                    Style="{StaticResource GreenButton}"
                    Command="{Binding AddCompletedTaskCommand}"
                    Height="28"
                    FontSize="10"
                    Padding="8,4"/>
                        </Grid>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- MODAL OVERLAY: TRYB SKUPIENIA (FOCUS MODE) -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Panel.ZIndex="1000"
              Visibility="{Binding HasFocusTask, Converter={StaticResource BoolToVis}}">
            
            <!-- Dimmed Background -->
            <Border Background="#D90B0914"/>
            
            <!-- Centered Modal Content Card -->
            <Border Width="450" Height="300"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AccentPurpleShadowBrush}"
                    BorderThickness="1,1,1,4"
                    CornerRadius="16"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource CardShadow}" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🎯" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="TRYB SKUPIENIA" FontSize="16" FontWeight="Black"
                                   Foreground="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Middle Content: Task Title and Big Timer -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Task Title -->
                        <TextBlock Text="{Binding FocusTask.Title}"
                                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" TextWrapping="Wrap" MaxWidth="380"
                                   TextAlignment="Center"/>
                        
                        <!-- Big Timer Display -->
                        <TextBlock Text="{Binding TimerDisplay}"
                                   FontSize="48" FontWeight="Black" Foreground="White"
                                   HorizontalAlignment="Center" FontFamily="Consolas, Monospace"/>
                        
                        <!-- Pulsing/Status text -->
                        <TextBlock FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TimerRunning}" Value="True">
                                            <Setter Property="Text" Value="Czas płynie... Skup się na zadaniu!" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TimerRunning}" Value="False">
                                            <Setter Property="Text" Value="Wstrzymano" />
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    
                    <!-- Footer Buttons -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Toggle Button (Start / Pause) -->
                        <Button Grid.Column="0"
                                Command="{Binding ToggleTimerCommand}"
                                Height="36" FontSize="11" Padding="12,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TimerRunning}" Value="True">
                                            <Setter Property="Content" Value="⏸ Pauza"/>
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueShadowBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TimerRunning}" Value="False">
                                            <Setter Property="Content" Value="▶ Start"/>
                                            <Setter Property="Background" Value="{StaticResource AccentPurpleBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleShadowBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- Save Button -->
                        <Button Grid.Column="2" Content="💾 Zapisz"
                                Style="{StaticResource GreenButton}"
                                Command="{Binding SaveTimerCommand}"
                                Height="36" FontSize="11" Padding="12,0"/>
                        
                        <!-- Exit Button -->
                        <Button Grid.Column="4" Content="✕ Wyjdź"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding StopFocusCommand}"
                                Height="36" FontSize="11" Padding="12,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL OVERLAY: EDYCJA ZADANIA -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Panel.ZIndex="1000"
              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            
            <!-- Dimmed Background -->
            <Border Background="#D90B0914"/>
            
            <!-- Centered Modal Content Card -->
            <Border Width="400" Height="340"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AccentPurpleShadowBrush}"
                    BorderThickness="1,1,1,4"
                    CornerRadius="16"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource CardShadow}" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="✏️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="EDYCJA ZADANIA" FontSize="14" FontWeight="Black"
                                   Foreground="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Middle Content: Form -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <!-- Task Title -->
                        <TextBlock Text="Nazwa zadania" Style="{StaticResource NewTaskLabel}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Height="32"
                                 FontSize="12"
                                 Padding="8,4"
                                 Text="{Binding EditingTask.Title, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>
                        
                        <!-- Difficulty -->
                        <TextBlock Text="Trudność" Style="{StaticResource NewTaskLabel}" Margin="0,0,0,4"/>
                        <ListBox Style="{StaticResource SegmentedListBox}"
                                 ItemContainerStyle="{StaticResource SegmentedListBoxItem}"
                                 SelectedValue="{Binding EditingTask.Difficulty}"
                                 SelectedValuePath="Tag"
                                 Margin="0,0,0,12">
                            <ListBoxItem Content="⭐ Łatwe" Tag="1"/>
                            <ListBoxItem Content="⭐⭐ Średnie" Tag="2"/>
                            <ListBoxItem Content="⭐⭐⭐ Trudne" Tag="3"/>
                        </ListBox>

                        <!-- Due Date -->
                        <TextBlock Text="Termin" Style="{StaticResource NewTaskLabel}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding EditingTask.DueDate}"
                                    Height="32"
                                    Margin="0,0,0,12"
                                    Padding="8,0"
                                    VerticalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Footer Buttons -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Cancel Button -->
                        <Button Grid.Column="0" Content="✕ Anuluj"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding CancelEditCommand}"
                                Height="36" FontSize="11" Padding="12,0"/>
                        
                        <!-- Save Button -->
                        <Button Grid.Column="2" Content="💾 Zapisz"
                                Style="{StaticResource GreenButton}"
                                Command="{Binding SaveEditCommand}"
                                Height="36" FontSize="11" Padding="12,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>