<Window x:Class="MyWay.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyWay.ViewModels"
        xmlns:views="clr-namespace:MyWay.Views"
        Title="MyWay" Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BgDarkBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border CornerRadius="12" Background="{StaticResource BgDarkBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ SIDEBAR ═══ -->
            <Border Grid.Column="0"
                    Background="#13133A"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <Border Grid.Row="0" MouseDown="TitleBar_MouseDown" Cursor="SizeAll"
                            Padding="20,22,20,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Border Width="8" Height="28" CornerRadius="4"
                                        Background="{StaticResource AccentPurpleBrush}"
                                        Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MyWay" FontSize="22" FontWeight="Black"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Twoja produktywność" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="18,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                               Fill="{StaticResource BorderBrush}" Margin="16,0"/>

                    <!-- Nawigacja -->
                    <StackPanel Grid.Row="1" Margin="0,16,0,0">

                        <TextBlock Text="MENU" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="20,0,0,8" Opacity="0.6"/>

                        <Button Style="{StaticResource NavButton}"
                                Margin="0,1" Tag="0"
                                Click="NavBtn_Click" x:Name="BtnDashboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dzisiaj" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Margin="0,1" Tag="1"
                                Click="NavBtn_Click" x:Name="BtnTasks">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✅" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Zadania" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Margin="0,1" Tag="3"
                                Click="NavBtn_Click" x:Name="BtnStats">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Statystyki" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Margin="0,1" Tag="4"
                                Click="NavBtn_Click" x:Name="BtnProfile">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Profil" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Dziś – szybki podgląd -->
                    <Border Grid.Row="2" Margin="12,0,12,14" Padding="14,12"
                            Background="#0D0E24" CornerRadius="12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="DZIŚ" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,10" Opacity="0.6"/>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3"
                                        Background="{StaticResource AccentGreenBrush}"
                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Ukończone"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Tasks.TodayCompleted, Mode=OneWay}"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreenBrush}"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3"
                                        Background="#FF7043"
                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Zaległe"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Tasks.OverdueCount, Mode=OneWay}"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#FF7043"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3"
                                        Background="{StaticResource AccentPurpleBrush}"
                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Nawyki"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Dashboard.CompletedToday, Mode=OneWay}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource AccentPurpleBrush}"/>
                                    <TextBlock Text="/" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="2,0"/>
                                    <TextBlock Text="{Binding Dashboard.Habits.Count, Mode=OneWay}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ GŁÓWNA TREŚĆ ═══ -->
            <Grid Grid.Column="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,8,8,0" Panel.ZIndex="10">
                    <Button Content="—" Width="30" Height="24" FontSize="14"
                            Style="{StaticResource GhostButton}" Padding="0"
                            Click="Minimize_Click"/>
                    <Button x:Name="BtnMaximize" Content="☐" Width="30" Height="24" FontSize="14"
                            Style="{StaticResource GhostButton}" Padding="0"
                            Click="Maximize_Click" Margin="4,0,0,0"/>
                    <Button Content="✕" Width="30" Height="24" FontSize="12"
                            Style="{StaticResource DangerButton}" Padding="0"
                            Click="Close_Click" Margin="4,0,0,0"/>
                </StackPanel>

                <views:DashboardView x:Name="PageDashboard" DataContext="{Binding Dashboard}"
                                     Visibility="Visible"/>
                <views:TasksView x:Name="PageTasks" DataContext="{Binding Tasks}"
                                 Visibility="Collapsed"/>
                <views:StatsView x:Name="PageStats" DataContext="{Binding Dashboard}"
                                 Visibility="Collapsed"/>
                <views:ProfileView x:Name="PageProfile" DataContext="{Binding Profile}"
                                   Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
